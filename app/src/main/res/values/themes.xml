<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Pymobile" parent="android:Theme.Material.NoActionBar" />

    <!-- Shown by the system while the app starts, then replaced by Theme.Pymobile. -->
    <style name="Theme.Pymobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Pymobile</item>
    </style>
</resources>
